#
# Ghostty config
#

# Theme
theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font

# Initial window size
window-width  = 160
window-height = 80

# Auto-update (automatically download)
auto-update = download

# Disable close confirmation
confirm-close-surface = false

# TERM normalization for ssh lives in ~/.ssh/config (SetEnv under Host *), which
# is the one boundary every path crosses -- tmux panes, nvim :term, and scripts
# never inherit a `term =` set here. Keep the native TERM locally so nvim gets
# undercurl; ssh-env still forwards COLORTERM=truecolor.
shell-integration-features = ssh-env

# MacOS
macos-option-as-alt = true

# Desktop desktop-notifications
desktop-notifications = true
