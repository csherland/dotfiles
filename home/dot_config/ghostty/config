#
# Ghostty config
#

# Theme
theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font

# Initial window size
window-width  = 160
window-height = 80

# Auto-update (automatically download)
auto-update = download

# Disable close confirmation
confirm-close-surface = false

# Keep the native TERM locally so nvim gets undercurl; ssh-env still forwards
# COLORTERM=truecolor. TERM is normalized per-transport instead, because no single
# boundary covers everything: ssh via `SetEnv TERM` in ~/.ssh/config (Host *), and
# et via the wrapper in ~/.config/zsh/aliases (et ignores ssh_config entirely).
# Any new remote tool needs its own downgrade, or remote tmux will refuse the TERM.
shell-integration-features = ssh-env

# MacOS
macos-option-as-alt = true

# Desktop desktop-notifications
desktop-notifications = true
