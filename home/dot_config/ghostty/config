#
# Ghostty config
#

# Theme
theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font

# Initial window size
window-width  = 160
window-height = 80

# Auto-update (automatically download)
auto-update = download

# Disable close confirmation
confirm-close-surface = false

# Fix ssh: remote hosts don't ship xterm-ghostty terminfo, and ssh-terminfo only
# fires from shells Ghostty spawned directly (not tmux panes, nvim :term, scripts).
# Send a TERM everything already knows; ssh-env still forwards COLORTERM=truecolor.
term = xterm-256color
shell-integration-features = ssh-env

# MacOS
macos-option-as-alt = true

# Desktop desktop-notifications
desktop-notifications = true
