# tmux: bare `tmux` attaches to the most recent session when one exists, instead of
# creating another. Any arguments (ls, new -s foo, kill-server) pass straight through.
tmux() {
  if [[ $# -eq 0 && -z "$TMUX" ]] && command tmux has-session 2>/dev/null; then
    command tmux attach
  else
    command tmux "$@"
  fi
}

# et speaks its own protocol and never reads ~/.ssh/config, so the `SetEnv TERM`
# that normalizes ssh doesn't apply -- it forwards TERM=xterm-ghostty verbatim and
# remote tmux dies with "open terminal failed: missing or unsuitable terminal".
# Send a TERM every host already has terminfo for; local TERM stays untouched.
et() {
  TERM=xterm-256color command et "$@"
}
