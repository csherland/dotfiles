# Interactive-only shell settings. Exports that scripts also need
# (PATH, EDITOR, XDG_CONFIG_HOME, ...) live in ~/.zshenv.

# History (fallback — atuin handles history when available)
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Colours for completion listings and eza (LS_COLORS is unset on macOS)
if command -v vivid >/dev/null 2>&1; then
  export LS_COLORS="$(vivid generate catppuccin-mocha)"
fi
